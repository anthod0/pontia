#!/usr/bin/env bash
set -euo pipefail
umask 077
mkdir -p "$PONTIA_HOME" "$HOME/.pi/agent" "$HOME/.codex" "$CLAUDE_CONFIG_DIR" "$HOME/workspace"
if [[ ! -f "$HOME/.codex/auth.json" && -f /e2e-auth/codex.json ]]; then
  cp /e2e-auth/codex.json "$HOME/.codex/auth.json"
fi
if [[ ! -f "$HOME/.pi/agent/auth.json" && -f /e2e-auth/pi.json ]]; then
  cp /e2e-auth/pi.json "$HOME/.pi/agent/auth.json"
fi
if [[ ! -f "$CLAUDE_CONFIG_DIR/.credentials.json" && -f /e2e-auth/claude.json ]]; then
  cp /e2e-auth/claude.json "$CLAUDE_CONFIG_DIR/.credentials.json"
fi
if [[ ! -f "$CLAUDE_CONFIG_DIR/settings.json" && -f /e2e-auth/claude-settings.json ]]; then
  cp /e2e-auth/claude-settings.json "$CLAUDE_CONFIG_DIR/settings.json"
fi
if [[ ! -f "$PONTIA_HOME/config.toml" ]]; then
  printf 'external_api_token = "%s"\n' "$(openssl rand -hex 32)" > "$PONTIA_HOME/config.toml"
  cat /opt/pontia/config.toml >> "$PONTIA_HOME/config.toml"
fi
if [[ ! -f "$HOME/.pi/agent/settings.json" ]]; then
  printf '%s\n' '{"packages":["/opt/pontia/clients/pi"]}' > "$HOME/.pi/agent/settings.json"
fi
if [[ ! -f "$HOME/.codex/config.toml" ]]; then
  printf '%s\n' 'sandbox_mode = "workspace-write"' 'approval_policy = "on-request"' > "$HOME/.codex/config.toml"
fi
if [[ ! -d "$HOME/workspace/.git" ]]; then
  git -C "$HOME/workspace" init --initial-branch=main
fi
codex app-server daemon start
exec pontiad
