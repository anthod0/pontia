# Local development defaults. Environment variables take precedence over config.toml.
# Required: a non-empty absolute path. TOML loads only from $PONTIA_HOME/config.toml.
PONTIA_HOME=/absolute/path/to/pontia-home
# Token used to authenticate External API requests.
PONTIA_EXTERNAL_API_TOKEN=dev-token
PONTIA_RUN_MIGRATIONS=true
