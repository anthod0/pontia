{
  "name": "@pontia/website",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && vite dev --host",
    "build": "vite build",
    "preview": "bun run db:migrate && wrangler dev --port 4173",
    "deploy": "bun run build && wrangler d1 migrations apply DB --remote --env= && wrangler deploy --env=",
    "deploy:staging": "bun run build && wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.toml && wrangler preview --name staging",
    "cf-typegen": "wrangler types",
    "prepare": "(svelte-kit sync && wrangler types) || echo ''",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "svelte-kit sync && wrangler types && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && wrangler types && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "bun test tests",
    "register:edge": "bun run scripts/register-edge.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "jose": "6.2.12",
    "phosphor-svelte": "^3.1.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.2",
    "cn": "^0.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "miniflare": "5.20260918.0-alpha",
    "oxfmt": "^0.70.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.97.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "workerd"
  ]
}
