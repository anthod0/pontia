# Copy the Local Dashboard values to .env.development.local and run `vite`.
# Copy the Public Dashboard values to .env.public.local and run
# `VITE_DASHBOARD_MODE=public vite`. Vite itself remains in development mode.
VITE_DASHBOARD_MODE=

# Optional development-only API proxy for the Public Dashboard.
PONTIA_PUBLIC_DEV_BACKEND=
PONTIA_EXTERNAL_API_TOKEN=
