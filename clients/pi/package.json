{
  "name": "@pontia/pi-client-plugin",
  "version": "0.2.0",
  "description": "Pi extension that connects coding-agent sessions to Pontia.",
  "keywords": [
    "pi-package",
    "pontia-client-plugin"
  ],
  "homepage": "https://pontia.dev/",
  "bugs": {
    "url": "https://github.com/anthod0/pontia/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "anthod0",
    "url": "https://github.com/anthod0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthod0/pontia.git",
    "directory": "clients/pi"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1 <1",
    "@types/node": "^22.15.3",
    "oxfmt": "^0.70.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.1 <1"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "trustedDependencies": [
    "esbuild",
    "koffi"
  ]
}
