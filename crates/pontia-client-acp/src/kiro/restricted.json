{
  "name": "pontia-restricted",
  "description": "Pontia restricted Session",
  "tools": ["read", "shell", "web"],
  "excludedTools": ["load_resource"],
  "resources": [],
  "includeMcpJson": false,
  "includePowers": false,
  "permissions": {
    "rules": [
      { "capability": "skill", "match": ["**"], "effect": "deny" },
      { "capability": "fs_read", "match": ["**"], "effect": "allow" },
      { "capability": "shell", "match": ["**"], "effect": "allow" },
      { "capability": "web_search", "match": ["**"], "effect": "allow" },
      { "capability": "web_fetch", "match": ["**"], "effect": "allow" }
    ]
  }
}
