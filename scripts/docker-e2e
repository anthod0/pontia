#!/usr/bin/env python3
"""Operate the repository's isolated Docker E2E environment."""

import argparse
import base64
from contextlib import closing, contextmanager
from datetime import datetime, timedelta, timezone
import fcntl
import hashlib
import io
import ipaddress
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import signal
import sqlite3
import subprocess
import sys
import tempfile
import tarfile

ROOT = Path(__file__).resolve().parent.parent
LAB = ROOT / "docker/e2e"
STATE = LAB / ".local"
EDGE_ID = "01900000-0000-7000-8000-000000000001"
EDGE_OWNER_ID = "01900000-0000-7000-8000-000000000002"
EDGE_NAME = "docker-e2e"
EDGE_HOST = f"{EDGE_NAME}.edge.pontia.dev"
TEST_USER_ID = "01900000-0000-7000-8000-000000000003"
TEST_SESSION_ID = "01900000-0000-7000-8000-000000000004"
AUTH_FILES = {
    "device": {
        "pi.json": "/home/e2e/.pi/agent/auth.json",
        "claude.json": "/home/e2e/.claude/.credentials.json",
    },
    "browser": {
        "Cookies": "/home/e2e/chromium/Default/Cookies",
        "Local State": "/home/e2e/chromium/Local State",
    },
}


def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def write_private(path, contents):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as output:
        temporary = Path(output.name)
        output.write(contents.encode() if isinstance(contents, str) else contents)
    try:
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def b64(value):
    return base64.urlsafe_b64encode(value).decode().rstrip("=")


def key_pair(algorithm):
    private = run(
        ["openssl", "genpkey", "-algorithm", algorithm, "-outform", "DER"],
        capture_output=True,
    ).stdout
    public = run(
        ["openssl", "pkey", "-inform", "DER", "-pubout", "-outform", "DER"],
        input=private, capture_output=True,
    ).stdout
    # RFC 8410 SubjectPublicKeyInfo for Ed25519 / X25519 has a 32-byte key.
    if len(public) != 44:
        raise ValueError("Unexpected public key encoding")
    return b64(private), b64(public[-32:])


def initialize(state):
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    (state / "openai-api-key").touch(mode=0o600)
    (state / "tls").mkdir(exist_ok=True, mode=0o700)
    for service in AUTH_FILES:
        (state / "auth" / service).mkdir(parents=True, exist_ok=True, mode=0o700)
    if not (state / "cloud.dev.vars").exists():
        signing, verification = key_pair("ED25519")
        proof_private, proof_public = key_pair("X25519")
        values = {
            "AUTH_ORIGIN": "https://pontia.dev",
            "JWT_SECRET": secrets.token_urlsafe(32),
            "E2E_CAPABILITY_SIGNING_KEY": signing,
            "E2E_CAPABILITY_VERIFICATION_KEY": verification,
            "E2E_REGISTRATION_PROOF_PRIVATE_KEY": proof_private,
            "E2E_REGISTRATION_PROOF_PUBLIC_KEY": proof_public,
            # Never give this environment permission to manage public DNS.
            "CLOUDFLARE_DNS_TOKEN": "disabled-in-local-e2e",
            "CLOUDFLARE_DNS_ZONE_ID": "disabled-in-local-e2e",
            "CLOUDFLARE_PREVIEW_DNS_ZONE_ID": "disabled-in-local-e2e",
            # The lab's public edge keeps the Pontia-managed DNS and preview flow.
            "LEGACY_EDGE_DNS_OWNER_IDS": EDGE_OWNER_ID,
        }
        write_private(state / "cloud.dev.vars", "".join(
            f"{key}={json.dumps(value)}\n" for key, value in values.items()
        ))
    elif "LEGACY_EDGE_DNS_OWNER_IDS" not in variables(state / "cloud.dev.vars"):
        path = state / "cloud.dev.vars"
        write_private(path, path.read_text() + f"LEGACY_EDGE_DNS_OWNER_IDS={json.dumps(EDGE_OWNER_ID)}\n")


def variables(path):
    result = {}
    for line in path.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        key, value = line.split("=", 1)
        parts = shlex.split(value, comments=True)
        result[key.strip()] = " ".join(parts)
    return result


def check_certificates(state, hosts):
    cert = state / "tls/fullchain.pem"
    key = state / "tls/privkey.pem"
    run(["openssl", "x509", "-in", str(cert), "-noout", "-checkend", "0"], capture_output=True)
    cert_public = run(
        ["openssl", "x509", "-in", str(cert), "-pubkey", "-noout"], capture_output=True,
    ).stdout
    key_public = run(
        ["openssl", "pkey", "-in", str(key), "-passin", "pass:", "-pubout"], capture_output=True,
    ).stdout
    if cert_public != key_public:
        raise ValueError("TLS certificate and private key do not match")
    for host in hosts:
        run([
            "openssl", "verify", "-purpose", "sslserver", "-verify_hostname", host,
            "-untrusted", str(cert), str(cert),
        ], capture_output=True)


def check(state):
    values = variables(state / "cloud.dev.vars")
    if values.get("AUTH_ORIGIN") != "https://pontia.dev":
        raise ValueError("AUTH_ORIGIN must remain https://pontia.dev inside this lab")
    if any(values.get(key) != "disabled-in-local-e2e" for key in (
        "CLOUDFLARE_DNS_TOKEN", "CLOUDFLARE_DNS_ZONE_ID",
    )):
        raise ValueError("Public DNS credentials are not permitted in this environment")
    if values.get("LEGACY_EDGE_DNS_OWNER_IDS") != EDGE_OWNER_ID:
        raise ValueError("LEGACY_EDGE_DNS_OWNER_IDS must name the lab edge owner; run scripts/docker-e2e init")
    hosts = ["pontia.dev", "app.pontia.dev", EDGE_HOST]
    check_certificates(state, hosts)


class Lab:
    def __init__(self, root, config, name="default"):
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,47}", name):
            raise ValueError("Instance name must be 1–48 lowercase letters, digits, underscores or hyphens")
        self.root = root.resolve()
        self.config = config.resolve()
        self.name = name
        checkout = hashlib.sha256(os.fsencode(self.root)).hexdigest()[:12]
        self.images = f"pontia-e2e-{checkout}"
        self.project = f"{self.images}-{name}"
        self.network = f"{self.project}_lab"
        self.state = self.config / "instances" / name

    @contextmanager
    def locked(self):
        self.state.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (self.state / ".lock").open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError(f"Instance {self.name} is busy") from None
            yield

    def compose(self, args, **kwargs):
        env = {key: value for key, value in os.environ.items()
               if not key.startswith(("COMPOSE_", "E2E_"))}
        # The documentation subnet only renders build/check config. Startup
        # creates the external network and records Docker's allocation first.
        allocation = self.state / "network.json"
        subnet = ipaddress.ip_network(json.loads(allocation.read_text())["subnet"]
                                      if allocation.exists() else "192.0.2.0/24")
        env.update(E2E_CONFIG=str(self.config), E2E_STATE=str(self.state),
                   E2E_IMAGES=self.images, E2E_NETWORK=self.network)
        env["E2E_CAPABILITY_VERIFICATION_KEY"] = variables(self.config / "cloud.dev.vars")["E2E_CAPABILITY_VERIFICATION_KEY"]
        for offset, service in enumerate(("cloud", "dashboard", "edge", "device", "browser"), 2):
            env[f"E2E_{service.upper()}_IP"] = str(subnet[offset])
        return run([
            "docker", "compose", "--ansi", "never", "--project-name", self.project,
            "--file", str(self.root / "docker/e2e/compose.yaml"), *args,
        ], env=env, **kwargs)

    def resources(self, resource):
        return run(["docker", resource, "ls", "-q", "--filter",
                    f"label=com.docker.compose.project={self.project}"], capture_output=True).stdout.strip()

    def prepare_auth(self):
        (self.config / "openai-api-key").touch(mode=0o600)
        for service, files in AUTH_FILES.items():
            for name in files:
                source = self.config / "auth" / service / name
                target = self.state / "auth" / service / name
                target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                if source.exists() and not target.exists():
                    write_private(target, source.read_bytes())
        settings = Path("auth/device/claude-settings.json")
        if (self.config / settings).exists():
            write_private(self.state / settings, (self.config / settings).read_bytes())
        else:
            (self.state / settings).unlink(missing_ok=True)

    def browser_url(self):
        address = self.compose(["port", "browser", "6080"], capture_output=True).stdout.decode().strip()
        return f"http://{address}/vnc.html?autoconnect=1&resize=scale"

    def up(self):
        with self.locked():
            if any(self.resources(resource) for resource in ("container", "volume", "network")):
                raise ValueError(f"Instance {self.name} already exists. Finish its task before running --name {self.name} down.")
            check(self.config)
            self.prepare_auth()
            try:
                write_private(self.state / "cloud-bootstrap.sql",
                              prepare_edge(self.state, self.config) + prepare_login(self.state))
                run(["docker", "network", "create", "--internal", "--label",
                     f"com.docker.compose.project={self.project}", self.network], capture_output=True)
                network = json.loads(run(["docker", "network", "inspect", self.network], capture_output=True).stdout)[0]
                subnet = network["IPAM"]["Config"][0]["Subnet"]
                write_private(self.state / "network.json", json.dumps({"subnet": subnet}))
                self.compose(["up", "-d", "--wait", "--wait-timeout", "180"])
                for client in ("pi", "codex", "claude-agent", "grok"):
                    self.compose(["exec", "-T", "device", "pontia", "client", "enable", client])
                print(f"Instance: {self.name} ({self.project})")
                print(f"Test browser: {self.browser_url()}")
            except BaseException:
                self.stop()
                raise

    def down(self):
        with self.locked():
            self.stop()

    def stop(self):
        containers = {}
        for service in AUTH_FILES:
            result = self.compose(["ps", "--all", "--quiet", service], capture_output=True)
            if result.stdout.strip():
                containers[service] = result.stdout.decode().strip()
        self.compose(["stop"])
        if "device" in containers:
            for name, path in AUTH_FILES["device"].items():
                contents = container_file(containers["device"], path)
                if contents is not None:
                    write_private(self.state / "auth/device" / name, contents)
        if "browser" in containers:
            save_browser_credentials(containers["browser"], self.state)
        self.compose(["down", "--volumes", "--remove-orphans"])
        if self.resources("network"):
            run(["docker", "network", "rm", self.network], capture_output=True)
        for name in ("edge/config.json", "edge/credential", "edge/tls.pem", "cloud-bootstrap.sql",
                     "edge/preview-tls.pem", "preview-cert.pem", "browser-login.json", "network.json"):
            (self.state / name).unlink(missing_ok=True)
        print(f"Instance {self.name} removed. Its login credentials are retained in {self.state / 'auth'}.")

    def login_device(self):
        self.compose(["exec", "-T", "device", "pontia", "login"])
        self.compose(["exec", "-T", "device", "pontia", "remote", "edges"])
        self.compose(["exec", "-T", "device", "pontia", "remote", "enable",
                      "--edge", EDGE_ID, "--name", f"Docker E2E {self.name}"])
        self.compose(["restart", "device"])
        self.compose(["up", "-d", "--wait", "--wait-timeout", "180", "device"])
        # Doctor reports registration and the URL, but exits 1 without systemd.
        try:
            self.compose(["exec", "-T", "device", "pontia", "doctor"])
        except subprocess.CalledProcessError as error:
            if error.returncode != 1:
                raise


def container_file(container, path):
    result = subprocess.run(["docker", "cp", f"{container}:{path}", "-"], capture_output=True)
    if result.returncode:
        if b"Could not find the file" in result.stderr:
            return None
        raise ValueError(f"Could not preserve credentials from {container}; containers are stopped.")
    with tarfile.open(fileobj=io.BytesIO(result.stdout)) as archive:
        members = archive.getmembers()
        if len(members) != 1 or not members[0].isfile():
            raise ValueError("Expected a regular credential file")
        return archive.extractfile(members[0]).read()


def save_browser_credentials(container, state):
    cookies = container_file(container, AUTH_FILES["browser"]["Cookies"])
    if cookies is None:
        return
    # Keep agent client login cookies, never the disposable Pontia login or profile.
    with tempfile.TemporaryDirectory(prefix="pontia-e2e-cookies-") as temporary:
        path = Path(temporary) / "Cookies"
        write_private(path, cookies)
        for suffix in ("-wal", "-journal"):
            contents = container_file(container, AUTH_FILES["browser"]["Cookies"] + suffix)
            if contents:
                write_private(Path(str(path) + suffix), contents)
        with closing(sqlite3.connect(path)) as database:
            providers = ("openai.com", "anthropic.com", "claude.ai", "auth0.com")
            keep = " OR ".join("(host_key = ? OR host_key LIKE ?)" for _ in providers)
            database.execute(f"DELETE FROM cookies WHERE NOT ({keep})",
                             [value for domain in providers for value in (domain, f"%.{domain}")])
            database.commit()
            database.execute("PRAGMA journal_mode=DELETE")
            database.execute("VACUUM")
        write_private(state / "auth/browser/Cookies", path.read_bytes())
    local_state = container_file(container, AUTH_FILES["browser"]["Local State"])
    if local_state is not None:
        encryption = json.loads(local_state).get("os_crypt", {})
        write_private(state / "auth/browser/Local State", json.dumps({"os_crypt": encryption}))


def run_task(lab, args):
    def interrupted(signum, frame):
        raise KeyboardInterrupt

    previous = signal.signal(signal.SIGTERM, interrupted)
    try:
        lab.up()
        try:
            with subprocess.Popen(args or ["bash"], cwd=lab.root,
                                  env=dict(os.environ, PONTIA_E2E_NAME=lab.name)) as task:
                try:
                    status = task.wait()
                except BaseException:
                    task.kill()
                    task.wait()
                    raise
                if status:
                    raise subprocess.CalledProcessError(status, args or ["bash"])
        finally:
            lab.down()
    finally:
        signal.signal(signal.SIGTERM, previous)


def prepare_edge(state, config):
    # Only called for a fresh run. Keep Cloud's hash and the edge credential paired.
    secret = secrets.token_urlsafe(32)
    seed = (LAB / "cloud-edge.sql").read_text().format(
        owner_id=EDGE_OWNER_ID, edge_id=EDGE_ID, name=EDGE_NAME, hostname=EDGE_HOST,
        credential_hash=b64(hashlib.sha256(secret.encode()).digest()),
    )
    write_private(state / "edge/credential", f"pec_v1_{EDGE_ID}_{secret}\n")
    write_private(state / "edge/config.json", json.dumps({
        "hostname": EDGE_HOST,
        "port": 443,
        "acme_challenge": "http-01",
        "browser_dashboard_origin": "https://app.pontia.dev",
        "preview_base_hostname": f"{EDGE_NAME}.pontia.run",
    }) + "\n")

    write_private(state / "edge/tls.pem",
                  (config / "tls/fullchain.pem").read_bytes().rstrip() + b"\n"
                  + (config / "tls/privkey.pem").read_bytes())
    # Give the disposable browser just the public leaf. Keep the key on the edge.
    with tempfile.TemporaryDirectory() as temporary:
        key = Path(temporary) / "preview.key"
        cert = run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt",
                    "ec_paramgen_curve:P-256", "-nodes", "-days", "2", "-keyout", str(key),
                    "-subj", "/CN=Docker E2E Preview", "-addext", "basicConstraints=CA:FALSE",
                    "-addext", "extendedKeyUsage=serverAuth", "-addext",
                    "subjectAltName=DNS:*.docker-e2e.pontia.run"], capture_output=True).stdout
        write_private(state / "preview-cert.pem", cert)
        write_private(state / "edge/preview-tls.pem", cert + key.read_bytes())
    return seed


def prepare_login(state):
    # Only called for a fresh run. The browser refresh cookie lets Cloud issue
    # the access token through its normal session refresh.
    token = f"ptb_{b64(secrets.token_bytes(32))}"
    expires = datetime.now(timezone.utc) + timedelta(days=30)
    seed = (LAB / "cloud-login.sql").read_text().format(
        user_id=TEST_USER_ID, session_id=TEST_SESSION_ID,
        token_hash=b64(hashlib.sha256(token.encode()).digest()),
        expires_at=expires.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
    )
    write_private(state / "browser-login.json", json.dumps({
        "name": "__Host-_rt", "value": token, "url": "https://pontia.dev/", "secure": True,
        "httpOnly": True, "sameSite": "Lax", "expires": int(expires.timestamp()),
    }) + "\n")
    return seed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--name", default=os.environ.get("PONTIA_E2E_NAME", "default"),
                        help="Instance within this checkout (default: PONTIA_E2E_NAME or default)")
    parser.add_argument("command", choices=("init", "check", "build", "up", "run", "login-device", "down", "compose"))
    parser.add_argument("args", nargs=argparse.REMAINDER)
    options = parser.parse_args()
    lab = Lab(ROOT, STATE, options.name)
    if options.command not in ("compose", "run") and options.args:
        parser.error("Extra arguments are only supported by compose and run")
    if options.command == "init":
        initialize(STATE)
        print(f"Place certificates in {STATE / 'tls'}.")
        return
    if not (STATE / "cloud.dev.vars").exists():
        raise ValueError("Run scripts/docker-e2e init first")
    if options.command == "check":
        check(STATE)
        lab.compose(["config", "--quiet"])
        print("Configuration and certificates checked; this is not an E2E test result.")
    elif options.command == "build":
        definition = lab.compose(["build", "--print"], capture_output=True)
        run(["docker", "buildx", "bake", "--file", "-", "--allow=network.host", "--pull", "--load"],
            input=definition.stdout, cwd=ROOT)
    elif options.command == "up":
        lab.up()
    elif options.command == "run":
        run_task(lab, options.args)
    elif options.command == "login-device":
        lab.login_device()
    elif options.command == "down":
        lab.down()
    elif options.command == "compose":
        lab.compose(options.args)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        # Never echo stdin: it may contain credentials or a private key.
        print(f"Command failed (exit {error.returncode}).", file=sys.stderr)
        if error.stderr:
            print(error.stderr.decode(errors="replace")[:4096], file=sys.stderr)
        sys.exit(1)
    except (ValueError, OSError) as error:
        print(f"docker-e2e: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
